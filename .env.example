PORT=3000
BITRIX_URL=https://your-company.bitrix24.ru
BITRIX_LOGIN=your-email@example.com
BITRIX_PASSWORD=your-password
HEADLESS=True

# Какой браузер использовать для Playwright:
#   false (по умолчанию) — встроенный Chromium от Playwright
#   true                 — системный Google Chrome (channel: 'chrome'), не нужно таскать Chromium
USE_SYSTEM_CHROME=false

# Сколько миллисекунд браузер может простаивать без сообщений, прежде чем закрыться.
# 0 — не закрывать (живёт постоянно). По умолчанию 300000 (5 минут).
IDLE_TIMEOUT_MS=300000

# Если автоматический вход не удался (капча, неверный пароль) — открывать видимый
# (не headless) браузер, чтобы пользователь вошёл и решил капчу вручную.
# true (по умолчанию) — открывать, false — сразу ошибка без ручного входа.
INTERACTIVE_LOGIN=true

# Сколько миллисекунд ждать ручного входа в видимом браузере.
# По умолчанию 300000 (5 минут).
INTERACTIVE_LOGIN_TIMEOUT_MS=300000

# Пауза перед повторной попыткой при ошибках авторизации, чтобы не «долбить»
# форму входа и не продлевать капчу. По умолчанию 600000 (10 минут).
AUTH_RETRY_DELAY_MS=600000


