PORT=3000
BITRIX_URL=https://your-company.bitrix24.ru
BITRIX_LOGIN=your-email@example.com
BITRIX_PASSWORD=your-password
HEADLESS=True

# Какой браузер использовать для Playwright:
#   false (по умолчанию) — встроенный Chromium от Playwright
#   true                 — системный Google Chrome (channel: 'chrome'), не нужно таскать Chromium
USE_SYSTEM_CHROME=false

# Сколько миллисекунд браузер может простаивать без сообщений, прежде чем закрыться.
# 0 — не закрывать (живёт постоянно). По умолчанию 300000 (5 минут).
IDLE_TIMEOUT_MS=300000


